{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:seo",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/public/forms/contact",
      "destination": "https://wrsqwdtjbglzuajjxtmc.supabase.co/functions/v1/public-forms-contact"
    },
    {
      "source": "/api/public/forms/classement",
      "destination": "https://wrsqwdtjbglzuajjxtmc.supabase.co/functions/v1/public-forms-classement"
    },
    {
      "source": "/api/public/simulations",
      "destination": "https://api-dev.etoilys.fr/public/simulations"
    },
    {
      "source": "/api/public/simulations/:path*",
      "destination": "https://api-dev.etoilys.fr/public/simulations/:path*"
    },
    {
      "source": "/simulateur/:simulationId",
      "destination": "/simulation-noindex.html"
    }
  ]
}
