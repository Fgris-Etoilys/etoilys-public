{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:seo": "npm run images:check && npm run typecheck && npm run seo:sitemap && vite build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "images:build": "node scripts/images-build.mjs",
    "images:check": "node scripts/images-build.mjs --check",
    "dordogne:meubles": "tsx scripts/fetch-dordogne-meubles.ts",
    "lot-et-garonne:meubles": "tsx scripts/fetch-lot-et-garonne-meubles.ts",
    "taxe-sejour:data": "tsx scripts/build-taxe-sejour-dataset.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.ts",
    "indexnow:submit": "tsx scripts/indexnow-submit.ts",
    "verify:i18n-release": "tsx --tsconfig tsconfig.app.json scripts/verify-i18n-release.ts",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cookie-consent:build": "tsx --tsconfig tsconfig.app.json scripts/test-cookie-consent-build.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@posthog/react": "^1.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.372.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@chialab/vitest-axe": "^0.19.2",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.14.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.2.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": "prettier --write"
  }
}
